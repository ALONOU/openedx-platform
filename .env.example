# Open edX - Docker Compose / Coolify
# Copier en .env et remplacer les valeurs. Ne pas commiter .env.

# ENVIRONMENT
ENVIRONMENT=production

# MYSQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS
MYSQL_DATABASE=openedx
MYSQL_USER=openedx
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS

# MONGODB
MONGO_DATABASE=openedx
MONGO_USER=openedx
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS
# Root user Mongo est souvent créé dans DB admin (Coolify compose)
MONGO_AUTH_SOURCE=admin

# REDIS (auth non utilisée par défaut dans config; décommenter si Redis protégé)
# REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS

# MEILISEARCH
MEILI_MASTER_KEY=CHANGE_ME_STRONG_PASSWORD_32_CHARS

# DJANGO
SECRET_KEY=CHANGE_ME_DJANGO_SECRET_KEY_50_CHARS
ALLOWED_HOSTS=lms.example.com,studio.example.com,localhost
LMS_ROOT_URL=https://lms.example.com
CMS_ROOT_URL=https://studio.example.com
# Requis pour Studio (MFE Authoring)
COURSE_AUTHORING_MICROFRONTEND_URL=https://studio.example.com/authoring
# OAuth Studio -> LMS
SOCIAL_AUTH_EDX_OAUTH2_KEY=studio-sso
SOCIAL_AUTH_EDX_OAUTH2_SECRET=CHANGE_ME_STUDIO_SSO_SECRET
SOCIAL_AUTH_EDX_OAUTH2_URL_ROOT=https://lms.example.com
SOCIAL_AUTH_EDX_OAUTH2_PUBLIC_URL_ROOT=https://lms.example.com
LMS_HOST=lms.example.com
CMS_HOST=studio.example.com

# Admin (créé au 1er démarrage si définis ; à mettre dans Coolify → Environment)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_STRONG
# Compte technique OAuth Studio (ne pas reutiliser ADMIN_EMAIL)
STUDIO_WORKER_EMAIL=studio-worker@localhost
MEDIA_ROOT=/openedx/data/media

# EMAIL (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=admin@example.com

# LOCALISATION
LANGUAGE_CODE=fr
TIME_ZONE=Europe/Paris

# MVP feature flags
ENABLE_CERTIFICATES=true
ENABLE_COHORTS=true
ENABLE_BULK_EMAIL=true
ENABLE_INSTRUCTOR_EMAIL=true
ENABLE_GRADE_DOWNLOADS=true
ENABLE_STUDENT_NOTES=true
ENABLE_PREREQUISITE_COURSES=true
ENABLE_ENTRANCE_EXAMS=true
ENABLE_DISCUSSION_SERVICE=false
ENABLE_OAUTH2_PROVIDER=false
ENABLE_THIRD_PARTY_AUTH=false
ENABLE_SCORM=false
ENABLE_XAPI=false
ENABLE_COURSE_DISCOVERY=false
ENABLE_TEAMS=false
ENABLE_WIKI=false

# SECURITE
DEBUG=false
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true

# PERF
CONN_MAX_AGE=600
CACHE_TIMEOUT=300

# CELERY
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=django-db

# LOGGING
LOG_LEVEL=INFO
# 0 = stdout seulement (recommandé Docker/Coolify, évite crash si /openedx/data/logs non writable)
DJANGO_USE_FILE_LOGGING=0

# Migrations LMS (entrypoint): tentatives si MySQL pas encore prêt
MIGRATE_RETRY_MAX=12
MIGRATE_RETRY_SLEEP=5
